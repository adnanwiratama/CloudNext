# Application
NODE_ENV=development
APP_PORT=4000
APP_URL=http://localhost:4000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloud_erp
DB_USER=erp_user
DB_PASSWORD=erp_secure_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET=change-this-to-a-very-long-random-secret-key-in-production
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Storage
STORAGE_PATH=./uploads
MAX_FILE_SIZE=10485760

# Email (configure for production)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@cloud-erp.com

# App
APP_NAME=CloudERP
APP_VERSION=1.0.0
LOG_LEVEL=info
